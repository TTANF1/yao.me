# Server-only website -> Python FastAPI connection. Copy to .env.local.
# Required explicitly; the proxy has no localhost fallback.
SUPPORT_API_BASE_URL=http://127.0.0.1:8787
# Set a strong shared secret matching the Python service; never NEXT_PUBLIC_.
SUPPORT_SITE_TOKEN=

# Vercel cannot reach your workstation through 127.0.0.1 or localhost.
# For Vercel, use the reachable HTTPS tunnel/service origin here and the same token.
# Example: SUPPORT_API_BASE_URL=https://support-api.example.com
# This example does not provision Docker, a tunnel, or any hosted service.
